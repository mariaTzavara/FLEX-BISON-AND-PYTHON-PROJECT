%option caseless 
%{

#include "parser.tab.h"
#include <stdio.h>
#include <string.h>
int line = 1;
%}

%%

[ \t]+              { printf("%s", yytext); }
\r\n       { printf("\n"); line++; }
\n         { printf("\n"); line++; }
\r         { /* αγνοείται αν εμφανιστεί μόνο του */ }

"--".*      { /* ignore single line comment */ }
"/*"([^*]|\*+[^*/])*\*+"/"   { /* ignore multi line comment */ }

 /* =========================================================
 *                 ΛΕΞΕΙΣ-ΚΛΕΙΔΙΑ ΤΗΣ SQL
 * =========================================================
 *
 * Το yytext περιέχει το κείμενο που αναγνωρίστηκε.
 * Για παράδειγμα, αν διαβαστεί CREATE, τότε:
 *
 *     yytext = "CREATE"
 *
 * Με το return επιστρέφουμε το αντίστοιχο token στον Bison.
 */

"CREATE"      { printf("%s", yytext); return CREATE; }
"TABLE"       { printf("%s", yytext); return TABLE; }
"SELECT"      { printf("%s", yytext); return SELECT; }
"FROM"        { printf("%s", yytext); return FROM; }
"WHERE"       { printf("%s", yytext); return WHERE; }
"GROUP"       { printf("%s", yytext); return GROUP; }
"BY"          { printf("%s", yytext); return BY; }
"ORDER"       { printf("%s", yytext); return ORDER; }
"LIMIT"       { printf("%s", yytext); return LIMIT; }
"JOIN"        { printf("%s", yytext); return JOIN; }
"ON"          { printf("%s", yytext); return ON; }
"AS"          { printf("%s", yytext); return AS; }

 /* =========================================================
 *                       ΤΥΠΟΙ ΔΕΔΟΜΕΝΩΝ
 * =========================================================
 */

"INT"         { printf("%s", yytext); return INT; }
"FLOAT"       { printf("%s", yytext); return FLOAT; }
"VARCHAR"     { printf("%s", yytext); return VARCHAR; }

 /* =========================================================
 *                     ΛΟΓΙΚΟΙ ΤΕΛΕΣΤΕΣ
 * =========================================================
 */

"AND"         { printf("%s", yytext); return AND; }
"OR"          { printf("%s", yytext); return OR; }
"NOT"         { printf("%s", yytext); return NOT; }
"IN"          { printf("%s", yytext); return IN; }

 /* =========================================================
 *                      ΤΕΛΕΣΤΕΣ ΣΥΓΚΡΙΣΗΣ
 * =========================================================
 *
 * Οι τελεστές με δύο χαρακτήρες πρέπει να τοποθετούνται
 * πριν από τους αντίστοιχους τελεστές με έναν χαρακτήρα.
 *
 * Παρ' όλα αυτά, το Flex επιλέγει πρώτα τη μεγαλύτερη
 * δυνατή συμβολοσειρά που ταιριάζει με κάποιον κανόνα.
 */

"!="          { printf("%s", yytext); return NE; }
"<="          { printf("%s", yytext); return LE; }
">="          { printf("%s", yytext); return GE; }
"="           { printf("%s", yytext); return EQ; }
"<"           { printf("%s", yytext); return LT; }
">"           { printf("%s", yytext); return GT; }

 /* =========================================================
 *                         ΣΤΑΘΕΡΕΣ
 * =========================================================
 */

 /* Πραγματικός αριθμός.
 *
 * Αναγνωρίζει έναν ή περισσότερους αριθμούς πριν και μετά
 * από την τελεία, για παράδειγμα:
 *
 *     12.5
 *     3.14
 *     100.00
 */

[0-9]+"."[0-9]+     { printf("%s", yytext); return FLOAT_LITERAL; }

 /* Ακέραιος αριθμός.
 *
 * Αναγνωρίζει έναν ή περισσότερους αριθμητικούς χαρακτήρες,
 * για παράδειγμα: 5, 20 ή 1234.
 */

[0-9]+              { printf("%s", yytext); return INT_LITERAL; }

 /* Συμβολοσειρά μέσα σε διπλά εισαγωγικά.
 *
 * Παραδείγματα:
 *
 *     "Maria"
 *     "Computer Engineering"
 *
 * Το [^\"] σημαίνει οποιονδήποτε χαρακτήρα εκτός από
 * το διπλό εισαγωγικό.
 */

\"[^\"]*\"          { printf("%s", yytext); return STRING_LITERAL; }

 /* =========================================================
 *                        ΑΝΑΓΝΩΡΙΣΤΙΚΑ
 * =========================================================
 *
 * Ένα αναγνωριστικό:
 *
 * 1. Πρέπει να ξεκινά με γράμμα ή κάτω παύλα.
 * 2. Στη συνέχεια μπορεί να περιέχει γράμματα,
 *    αριθμούς ή κάτω παύλες.
 *
 * Παραδείγματα:
 *
 *     students
 *     student_name
 *     table2
 *     _temporary
 */

[a-zA-Z_][a-zA-Z0-9_]*   { yylval.str = strdup(yytext);
    printf("%s", yytext);
    return IDENTIFIER; 
    }  
    
    /* Η strdup(yytext) δημιουργεί αντίγραφο του αναγνωριστικού, 
    
    ώστε το όνομα να μπορεί να χρησιμοποιηθεί από τον συντακτικό αναλυτή. */ 

 /* =========================================================
 *                    ΣΥΜΒΟΛΑ ΚΑΙ ΔΙΑΧΩΡΙΣΤΙΚΑ
 * =========================================================
 */

 /* Το ελληνικό ερωτηματικό/semicolon ολοκληρώνει
 * μια εντολή SQL και επιστρέφεται ως token SEMICOLON.
 */

";"     { printf("%s", yytext); return SEMICOLON; }

 /* Για τα παρακάτω σύμβολα επιστρέφεται απευθείας
 * ο αντίστοιχος χαρακτήρας στον Bison.
 */

","     { printf("%s", yytext); return ','; }
"("     { printf("%s", yytext); return '('; }
")"     { printf("%s", yytext); return ')'; }
"*"     { printf("%s", yytext); return '*'; }
"."     { printf("%s", yytext); return '.'; }

 /* =========================================================
 *                     ΑΓΝΩΣΤΟΣ ΧΑΡΑΚΤΗΡΑΣ
 * =========================================================
 *
 * Η τελεία ταιριάζει με οποιονδήποτε χαρακτήρα που δεν
 * αναγνωρίστηκε από κάποιον προηγούμενο κανόνα.
 *
 * Εμφανίζεται μήνυμα λεκτικού λάθους, αλλά δεν επιστρέφεται
 * κάποιο token στον parser.
 */
.                   { fprintf(stderr, "Unknown character at line %d: %s\n", line, yytext); }

 /*
 * Το δεύτερο %% δηλώνει το τέλος των κανόνων.
 * Από εδώ και κάτω μπορούμε να γράψουμε κανονικό κώδικα C.
 */

%%

/*
 * Η yywrap() καλείται όταν ο lexer φτάσει στο τέλος
 * του αρχείου εισόδου.
 *
 * Επιστρέφοντας 1 δηλώνουμε ότι δεν υπάρχει άλλο αρχείο
 * εισόδου και η λεκτική ανάλυση πρέπει να ολοκληρωθεί.
*/
int yywrap() {
    return 1;
}
